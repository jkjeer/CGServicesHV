<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="PlantSection" type="CGServicesHV.Common.Types.Configuration.PlantConfiguration, CGServicesHV" />
  </configSections>
  <system.diagnostics>
    <sources>
      <source name="System.ServiceModel.MessageLogging">
        <listeners>
          <add name="messages" type="System.Diagnostics.XmlWriterTraceListener" initializeData="c:\temp\CGServicesHV.svclog" />
        </listeners>
      </source>
    </sources>
  </system.diagnostics>
  <appSettings>
    <add key="PrimaryEnvironment" value="Pd" />
    <add key="ReplicationEnvironment" value="ha" />
    <add key="ControlLib" value="ProdCTL" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="MailFromAddress" value="svcsoa@cardinalcorp.com" />
    <add key="MailConfirmToAddress" value="jkjeer@cardinalcorp.com" />
    <add key="MailBizToAddress" value="jpjenkin@cardinalcorp.com,jkjeer@cardinalcorp.com" />
    <add key="MailSysToAddress" value="jpjenkin@cardinalcorp.com, jkjeer@cardinalcorp.com" />
    <add key="MailErrorToAddress" value="jkjeer@cardinalcorp.com" />
    <add key="MailWoMgmtAddress" value="jpjenkin@cardinalcorp.com,jwolf@cardinalcorp.com,nwilson@cardinalcorp.com,jkessler@cardinalcorp.com" /> 
    <add key="MailFuseScheduleAddress" value="jpjenkin@cardinalcorp.com,jkjeer@cardinalcorp.com,jwolf@cardinalcorp.com,nwilson@cardinalcorp.com,jkessler@cardinalcorp.com" /> 	
    <add key="MailFuseAdminAddress" value="jpjenkin@cardinalcorp.com,jkjeer@cardinalcorp.com" /> 	
    <add key="MailBoxingAddress" value="jpjenkin@cardinalcorp.com,jkjeer@cardinalcorp.com,jwolf@cardinalcorp.com,nwilson@cardinalcorp.com,jkessler@cardinalcorp.com" />
    <add key="MailAuditConfirmToAddress" value="jkjeer@cardinalcorp.com" />
	<add key="ProcessResponseFilePath" value="\\svcpd\s$\Integration Service Notices"/>
	<!-- <add key="ProcessResponseFilePath" value="\\svcpy\s$\Integration Service Notices"/> -->
    <add key="SendPlantMail" value="true" />
    <add key="PlantEmailFormat" value="-Scheduling@cardinalcorp.com" />

	<add key="SmtpHost" value="smtp-postfix.cgi.int"/>
	<add key="SmtpPort" value="25"/>
	<add key="EnableSsl" value="false"/>
	<add key="UseDefaultCredentials" value="true"/>	
	<add key="SendingAccount" value="svcsoa@cardinalcorp.com"/>
	<add key="SendingPassword" value="svcsoA99"/>

    <add key="SmtpHostTimeout" value="10000" />
    <add key="MaxSFRowsPerBatch" value="500" />
    <add key="LockExpireMinutes" value="5" />
    <add key="BIPID" value="SQDR_CGMTO" />
    <add key="F4715LookbackDays" value="90" />
    <add key="BoxingQueryTimeout" value="120" />
    <add key="BulkCopyTimeout" value="1200" />
    <add key="PingTimeoutMs" value="4000" />	
    <add key="PingRetries" value="3" />		
	
	<!-- Racking/RawTags Audit settings -->
    <add key="BizOnlyBufferMinutes" value="20" />		
    <add key="RackDataRetentionDays" value="10" />		
	
  </appSettings>
  
  <connectionStrings>
    <add name="DV.iSeries" connectionString="DataSource=CORPI502;DefaultCollection=DVDTA;UserID=SOASVC;Password=FONZIE;DataCompression=True;Application Name=CGServicesHV;" />
    <add name="PY.iSeries" connectionString="DataSource=CORPI502;DefaultCollection=PYDTA;UserID=SOASVC;Password=FONZIE;DataCompression=True;Application Name=CGServicesHV;" />
    <add name="HA.iSeries" connectionString="DataSource=FLIP501;DefaultCollection=PRODDTA;UserID=SOASVC;Password=FONZIE;DataCompression=True;Application Name=CGServicesHV;" />
    <add name="PD.iSeries" connectionString="DataSource=CORPI501;DefaultCollection=PRODDTA;UserID=SOASVC;Password=FONZIE;DataCompression=True;Application Name=CGServicesHV;" />

    <add name="SOA.LOG" connectionString="Data Source=CGD1WASPY;Initial Catalog=SOA;Integrated Security=SSPI;Application Name=CGServicesHV;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient" />
    <add name="CORP.INTEGRATION" connectionString="Server=INTEGRATIONAG;Database=INTEGRATION;Integrated Security=SSPI;Connection Timeout=30;MultiSubnetFailover=True;Application Name=CGServicesHV;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient" />		
	<add name="DW" connectionString="Data Source=CGD1BISQL1;Initial Catalog=PSBI_WH_PROD;Integrated Security=SSPI;Application Name=CGServicesHV;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient" />
	<add name="CORP.WAREHOUSE" connectionString="Data Source=CGD1BISQL1;Initial Catalog=PSBI_WH_PROD;Integrated Security=SSPI;Application Name=CGServicesHV;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient" />			

    <add name="MZCG.INTEGRATION" connectionString="Data Source=MZCGSQLsrv;Initial Catalog=INTEGRATION;Integrated Security=SSPI;Application Name=CGServicesHV;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient" />

    <add name="MZCG.SHOPFLOOR" connectionString="Data Source=MZCGSQLsrv;Initial Catalog=HVShopFloor;Integrated Security=SSPI;Application Name=CGServicesHV;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient" />

    <add name="MZCG.CLEARPATH" connectionString="Data Source=MZCGSQLsrv;Initial Catalog=ClearPath_MZCGSQLsrv_Simulation;Integrated Security=SSPI;Application Name=CGServicesHV;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient" />
 
  </connectionStrings>

    <system.web>
    <compilation debug="true" />
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" Type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
